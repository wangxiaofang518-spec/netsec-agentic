# NetSec-Agentic — credentials and switches.
# Copy to secrets/agent.env (chmod 600, git-ignored) and fill in YOUR values.
# The same file drives `setup.sh --from-env-file` / `setup.ps1 -FromEnvFile` on a workstation.
# Values left as <placeholder> make the setup scripts stop with a clear message.

# ── Agent mode (safety switch) ───────────────────────────────────────────
# readonly   = investigate only; every configuration change is blocked by a guardrail (recommended to start)
# autonomous = the agent may propose changes; each one waits for human Approve / Reject in the UI
AGENT_MODE=readonly
# AGENT_APPROVAL=on              # autonomous mode only; "off" = changes run without confirmation (not recommended)
# AGENT_APPROVAL_TIMEOUT_MS=180000
AGENT_MAX_TURNS=50

# ── Model endpoint: AWS Bedrock (bearer token) ───────────────────────────
CLAUDE_CODE_USE_BEDROCK=1
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AGENT_MODEL_LIGHT=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AGENT_MODEL_HEAVY=<model id for deep investigations>
# ANTHROPIC_BEDROCK_BASE_URL=<your LLM gateway, if any>
# — or the Anthropic API directly (instead of Bedrock):
# ANTHROPIC_API_KEY=
# Load MCP tools on demand (~600 tools in total) — keeps the context small:
ENABLE_TOOL_SEARCH=true

# ── Strata Cloud Manager (scm MCP) ───────────────────────────────────────
SCM_CLIENT_ID=<your-service-account>@<your-tsg-id>.iam.panserviceaccount.com
SCM_CLIENT_SECRET=
SCM_TSG_ID=<your-tsg-id>

# ── PAN-OS firewalls (one MCP server each) ───────────────────────────────
# Management address + API key per firewall. Prefer keys of a read-only admin role.
# Names follow the reference lab; rename them in mcp.mjs / app.py / setup.* to match your estate.
PANOS_HOST_SASE_EXTERNAL_GW=<firewall-1-mgmt-ip>
PANOS_API_KEY_SASE_EXTERNAL_GW=
PANOS_HOST_SCVM_AWS_HK=<firewall-2-mgmt-ip>
PANOS_API_KEY_SCVM_AWS_HK=
PANOS_HOST_SCVM_AWS_SG=<firewall-3-mgmt-ip>
PANOS_API_KEY_SCVM_AWS_SG=
PANOS_HOST_AIVM_ALIBABA=<firewall-4-mgmt-ip>
PANOS_API_KEY_AIVM_ALIBABA=

# ── KOI (software supply chain) ──────────────────────────────────────────
KOI_API_KEY=

# ── Prisma AIRS (AI Runtime Security) ────────────────────────────────────
PANW_AI_SEC_API_KEY=
PANW_MGMT_CLIENT_ID=<your-service-account>@<your-tsg-id>.iam.panserviceaccount.com
PANW_MGMT_CLIENT_SECRET=
PANW_MGMT_TSG_ID=<your-airs-tsg-id>
