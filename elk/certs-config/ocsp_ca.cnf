[ ca ]
default_ca = CA_default

[ CA_default ]
dir              = /opt/elk/certs
database         = $dir/index.txt
serial           = $dir/ca.srl
certificate      = $dir/ca.crt
private_key      = $dir/ca.key
new_certs_dir    = $dir
default_md       = sha256
policy           = policy_any
x509_extensions  = usr_cert

[ policy_any ]
countryName            = optional
organizationName       = optional
commonName             = supplied

[ usr_cert ]
basicConstraints = CA:FALSE
