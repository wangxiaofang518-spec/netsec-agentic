# topo — status collector + login gate + /api proxy.
# Copy to secrets/topo.env (chmod 600, git-ignored) and fill in YOUR values.
# Use read-only API keys: the collector only runs <show> commands.

# ── Firewalls (management address + API key) ──
# Note: the collector names the HK firewall PANOS_*_SCVM_AWS (the agent uses PANOS_*_SCVM_AWS_HK) — same device, same key.
PANOS_HOST_SASE_EXTERNAL_GW=<firewall-1-mgmt-ip>
PANOS_API_KEY_SASE_EXTERNAL_GW=
PANOS_HOST_SCVM_AWS=<firewall-2-mgmt-ip>
PANOS_API_KEY_SCVM_AWS=
PANOS_HOST_SCVM_AWS_SG=<firewall-3-mgmt-ip>
PANOS_API_KEY_SCVM_AWS_SG=
PANOS_HOST_AIVM_ALIBABA=<firewall-4-mgmt-ip>
PANOS_API_KEY_AIVM_ALIBABA=

# ── Login gate for the page + /api proxy ──
TOPO_AUTH_USER=admin
TOPO_AUTH_PASS=<choose-a-strong-password>     # if empty, a random password is generated and printed in `docker logs topo`
# TOPO_SESSION_TTL=43200                      # session lifetime in seconds (12 h)
# TOPO_AUTH=off                               # disable the login entirely (not recommended)

# ── Optional tuning ──
# POLL_INTERVAL=30
# ES_URL=http://elasticsearch:9200
# AGENT_UPSTREAM=http://netsec-agent:8081
